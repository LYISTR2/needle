[Unit]
Description=Needle read-only monitoring panel
After=network.target

[Service]
Type=simple
DynamicUser=yes
User=needle-panel
Group=www-data
LoadCredential=panel.json:/etc/needle/panel.json
ExecStart=/usr/local/bin/needle serve --config %d/panel.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StateDirectory=needle-panel
StateDirectoryMode=0700
RuntimeDirectory=needle-panel
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @privileged @resources
MemoryMax=128M
TasksMax=32
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
