#!/usr/bin/env bash
# Local root-only administration. Data mutations execute as the same DynamicUser
# identities as the services; never create root-owned SQLite/WAL/ledger files.
set -euo pipefail
[[ ${EUID} -eq 0 ]] || { printf 'Run with sudo/root.\n' >&2; exit 1; }
bin=${NEEDLE_BINARY:-/usr/local/bin/needle}
config_dir=${NEEDLE_CONFIG_DIR:-/etc/needle}
panel_name=${NEEDLE_PANEL_NAME:-needle-panel}
agent_name=${NEEDLE_AGENT_NAME:-needle-agent}
unit="needle-admin-$(python3 -c 'import secrets; print(secrets.token_hex(6))')"
cleanup_file=''
cleanup() { [[ -z "$cleanup_file" ]] || rm -f -- "$cleanup_file"; }
trap cleanup EXIT
run_panel() {
  systemd-run --quiet --wait --pipe --collect --service-type=exec --unit="$unit" \
    -p DynamicUser=yes -p "User=$panel_name" -p Group=www-data \
    -p "StateDirectory=$panel_name" -p StateDirectoryMode=0700 -p UMask=0077 \
    -p NoNewPrivileges=yes -p ProtectSystem=strict -p ProtectHome=yes \
    -p PrivateTmp=yes -p PrivateDevices=yes -p RestrictAddressFamilies=AF_UNIX \
    -p "LoadCredential=panel.json:$config_dir/panel.json" \
    "$bin" "$@" --config "/run/credentials/$unit.service/panel.json"
}
case ${1:-} in
  set-admin)
    [[ $# -le 2 ]] || { printf 'Usage: needle-admin set-admin [USERNAME]\n' >&2; exit 1; }
    read -r -s -p 'New administrator password (12+ bytes): ' password < /dev/tty
    printf '\n' >&2
    printf '%s\n' "$password" | run_panel set-admin --username "${2:-admin}"
    unset password
    ;;
  add-node)
    [[ $# -eq 5 ]] || { printf 'Usage: needle-admin add-node ID NAME INTERFACE /absolute/output.json\n' >&2; exit 1; }
    [[ $2 =~ ^[a-zA-Z0-9_-]{1,64}$ && $5 == /* && ! -e $5 ]] || { printf 'Invalid id or output must be a new absolute path.\n' >&2; exit 1; }
    # The defaults are intentional; advanced custom state paths use the CLI directly.
    cleanup_file="/var/lib/$panel_name/enrollment-$unit.json"
    run_panel add-node --id "$2" --name "$3" --interface "$4" --agent-config "$cleanup_file"
    install -m 0600 "$cleanup_file" "$5"
    printf 'Private agent configuration: %s\n' "$5"
    ;;
  remove-node)
    [[ $# -eq 2 ]] || { printf 'Usage: needle-admin remove-node ID\n' >&2; exit 1; }
    run_panel remove-node --id "$2"
    ;;
  set-traffic)
    [[ $# -eq 3 && $2 =~ ^[0-9]+$ && $3 =~ ^[0-9]+$ ]] || { printf 'Usage: needle-admin set-traffic RX_BYTES TX_BYTES\n' >&2; exit 1; }
    if systemctl is-active --quiet "$agent_name"; then
      printf 'Stop needle-agent first: systemctl stop needle-agent\n' >&2; exit 1
    fi
    systemd-run --quiet --wait --pipe --collect --service-type=exec --unit="$unit" \
      -p DynamicUser=yes -p "User=$agent_name" -p "StateDirectory=$agent_name" \
      -p StateDirectoryMode=0700 -p UMask=0077 -p NoNewPrivileges=yes \
      -p ProtectSystem=strict -p ProtectHome=yes -p PrivateTmp=yes -p PrivateDevices=yes \
      -p "LoadCredential=agent.json:$config_dir/agent.json" \
      "$bin" set-traffic --config "/run/credentials/$unit.service/agent.json" --rx "$2" --tx "$3"
    ;;
  *)
    printf 'Commands:\n  needle-admin set-admin [USERNAME]\n  needle-admin add-node ID NAME INTERFACE /absolute/output.json\n  needle-admin remove-node ID\n  needle-admin set-traffic RX_BYTES TX_BYTES\n' >&2
    exit 1
    ;;
esac
